# Keep repository text deterministic across Windows and Linux checkouts.
*.md text eol=lf
*.c text eol=lf
*.h text eol=lf
*.py text eol=lf
*.conf text eol=lf
*.overlay text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
CMakeLists.txt text eol=lf
Kconfig text eol=lf
*.ps1 text eol=crlf
ml/** text=auto eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
# Historical command/stream receipts authenticate raw bytes, including CRLF.
ml/provenance/week3-sv2-linux/** -text
# New Week 5 receipts also authenticate raw stdout/stderr bytes.
ml/provenance/week5-20261009-v1/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
