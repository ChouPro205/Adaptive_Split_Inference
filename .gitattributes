# Keep repository text deterministic across Windows and Linux checkouts.
*.md text eol=lf
*.c text eol=lf
*.h text eol=lf
*.py text eol=lf
*.conf text eol=lf
*.overlay text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
CMakeLists.txt text eol=lf
Kconfig text eol=lf
*.ps1 text eol=crlf
# Shell scripts run on Linux/KV260; CRLF breaks bash.
*.sh text eol=lf
ml/** text=auto eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
# Keep the Week 5 Edge checksum list readable by sha256sum after Windows checkout.
results/week5/edge/sha256sum_export.txt text eol=lf
# Historical command/stream receipts authenticate raw bytes, including CRLF.
ml/provenance/week3-sv2-linux/** -text
# Week 3 CDC captures are stored LF; their published SHA-256 values are of the
# original CRLF bytes, so every checkout must restore CRLF, not only autocrlf.
results/week3/device/logs/*.txt text eol=crlf
# New Week 5 receipts also authenticate raw stdout/stderr bytes.
ml/provenance/week5-20261009-v1/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
ml/provenance/week5-pr25-fixes-20261011/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
ml/provenance/week5-pr25-r1r2-20261012/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
ml/provenance/week5-pr25-sv1-20261015/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
ml/provenance/week5-current-20261015/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol

# Week 6 command receipts preserve raw stdout/stderr bytes.
ml/provenance/week6-p1-20261016/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
# Week 6 dongle evidence: copies of checker/DFU outputs, hashed byte-exact in manifest.json.
results/week6/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
results/week6/device/README.md text eol=lf
# Week 7 PPK2/dongle evidence: copies of checker/DFU outputs, hashed byte-exact in manifest.json.
results/week7/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
results/week7/device/README.md text eol=lf
# Week 8 G2/PPK2 evidence: copies of checker/DFU outputs, hashed byte-exact in manifest.json.
results/week8/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
results/week8/device/README.md text eol=lf
