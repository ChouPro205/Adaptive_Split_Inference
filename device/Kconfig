mainmenu "Adaptive Split Inference firmware"

config APP_IDLE_MEASUREMENT
	bool "Build the Week 2 idle-current measurement firmware"
	default n
	help
	  Select the minimal firmware used to measure the PCA10059 idle
	  baseline. The normal Active firmware remains the default.

config APP_WEEK3_HEAD
	bool "Build the Week 3 FP32 head validation firmware"
	default n
	help
	  Run the v2 Conv1/ReLU1/Conv2/ReLU2/MaxPool1d head and expose
	  full FP32 milestone tensors through USB CDC ACM.

config APP_WEEK4_HEAD
	bool "Build the Week 4 R3 all-split FP32 validation firmware"
	default n
	depends on !APP_IDLE_MEASUREMENT && !APP_WEEK3_HEAD
	help
	  Run the authenticated R3 graph from normalized input at each call.
	  Select sample and split 0..10 over USB CDC; benchmark with DWT.

source "Kconfig.zephyr"
